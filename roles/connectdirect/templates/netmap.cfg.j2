# netmap.cfg generated by Ansible
# Environment: {{ environment }}
# Local node: {{ connectdirect_local_node }}

LOCAL_NODE={{ connectdirect_local_node }}
LISTEN_PORT={{ connectdirect_listen_port }}

{% for node in connectdirect_partner_nodes %}
PARTNER_NODE={{ node.name }}
  HOST={{ node.host }}
  PORT={{ node.port }}
  PROTOCOL={{ node.protocol | default('tcpip') }}
{% endfor %}
